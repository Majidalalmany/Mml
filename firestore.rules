rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user has an active, authorized admin document in adminUsers
    // STRICT: Insecure fallback (: true) removed. Only accounts existing in adminUsers with valid roles are authorized.
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.status != 'suspended' &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role in [
          'admin', 'super_admin', 'developer', 'vice_admin', 'stores_manager', 
          'finance_manager', 'accountant', 'customer_service', 'cs_restaurants', 
          'auditor', 'cashier', 'customer_data', 'content_writer', 'content_office', 'custom'
        ];
    }

    // Helper to check if caller owns the order
    function isOrderOwner(orderData) {
      return isAuthenticated() && (
        (orderData.userId != null && orderData.userId == request.auth.uid) ||
        (orderData.clientId != null && orderData.clientId == request.auth.uid) ||
        (orderData.customerId != null && orderData.customerId == request.auth.uid) ||
        (orderData.customerPhone != null && request.auth.token.phone_number != null && orderData.customerPhone == request.auth.token.phone_number)
      );
    }

    // 1. Admin Users Collection - Staff & Admin management
    match /adminUsers/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Clients Collection - Mobile app end-users
    match /clients/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 3. Drivers Collection - Delivery fleet
    match /drivers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Public Catalog (Stores, Products, Categories)
    // Public read for seamless customer mobile app browsing without requiring prior login; writes restricted to admins
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fazaa_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /manfaa_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Orders & Services Collections
    // Customers can create orders; Reading and Updating is strictly restricted to order owners or authorized admins
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (resource != null && isOrderOwner(resource.data));
      allow update, delete: if isAdmin() || (resource != null && isOrderOwner(resource.data));
    }

    match /fazaa_orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (resource != null && isOrderOwner(resource.data));
      allow update, delete: if isAdmin() || (resource != null && isOrderOwner(resource.data));
    }

    match /manfaa_orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (resource != null && isOrderOwner(resource.data));
      allow update, delete: if isAdmin() || (resource != null && isOrderOwner(resource.data));
    }

    // 6. Operational Collections (Audit Logs, Tickets & Invoices)
    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /driver_invoices/{invoiceId} {
      allow read, write: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.driverId);
    }

    // Strict default deny for any undefined or arbitrary paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
