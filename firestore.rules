rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    // Admin Users Collection - Staff management only
    match /adminUsers/{userId} {
      allow read, write: if true;
    }

    // Clients Collection - Customer app self-registration
    match /clients/{userId} {
      allow read, write: if true;
    }

    // Drivers Collection - Delivery captains
    match /drivers/{userId} {
      allow read, write: if true;
    }

    // Stores and Products
    match /stores/{storeId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders, Fazaa / Manfaa Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /fazaa_orders/{orderId} {
      allow read, write: if true;
    }

    match /manfaa_orders/{orderId} {
      allow read, write: if true;
    }

    match /fazaa_categories/{catId} {
      allow read, write: if true;
    }

    match /manfaa_categories/{catId} {
      allow read, write: if true;
    }

    // Audit logs & Support tickets
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    // Driver Invoices Collection
    match /driver_invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Catch-all for other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
