rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admin users collection
    match /adminUsers/{userId} {
      allow read, write: if true;
    }

    // 2. Stores & Categories Collections
    match /stores/{storeId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 3. Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // 4. Orders Collection (Main order flow for Dashboard & Flutter Client/Driver apps)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 5. Fazaa Orders & Shipment Categories
    match /fazaa_orders/{orderId} {
      allow read, write: if true;
    }

    match /fazaa_categories/{categoryId} {
      allow read, write: if true;
    }

    // 6. Audit logs & Support tickets
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
