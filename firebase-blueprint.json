{
  "entities": {
    "adminUsers": {
      "title": "Admin Users",
      "description": "Exclusive collection for Admin Dashboard management staff and moderators only",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Admin Document/Auth UID" },
        "name": { "type": "string", "description": "Full name of the admin staff" },
        "phone": { "type": "string", "description": "Mandatory primary phone number" },
        "email": { "type": "string", "description": "Optional email address" },
        "password": { "type": "string", "description": "Password or auth credentials" },
        "role": { 
          "type": "string", 
          "description": "Role level inside Admin Dashboard" 
        },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "storeId": { "type": "string" },
        "permissions": { 
          "type": "object", 
          "description": "Granular RBAC module permissions object { view: boolean, create: boolean, edit: boolean, delete: boolean }" 
        },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone", "role"]
    },
    "clients": {
      "title": "Clients (Customers)",
      "description": "Exclusive collection for Flutter Client Mobile App users",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Client Firebase Auth UID" },
        "name": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "Customer phone number" },
        "email": { "type": "string", "description": "Customer email address" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "role": { "type": "string", "enum": ["client"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "phone"]
    },
    "drivers": {
      "title": "Drivers (Delivery Captains)",
      "description": "Exclusive collection for Flutter Driver Mobile App captains",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Driver Firebase Auth UID" },
        "name": { "type": "string", "description": "Captain full name" },
        "phone": { "type": "string", "description": "Captain phone number" },
        "vehicleType": { "type": "string", "description": "Motorcycle, Car, Van" },
        "plateNumber": { "type": "string", "description": "Vehicle license plate number" },
        "isOnline": { "type": "boolean", "description": "Current availability status" },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "role": { "type": "string", "enum": ["driver"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "phone"]
    },
    "stores": {
      "title": "Stores and Services",
      "description": "Stores, restaurants, and service providers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "coverUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "maintenance"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "status"]
    },
    "products": {
      "title": "Products",
      "description": "Products available in stores",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "categoryId": { "type": "string" },
        "storeId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "price", "status"]
    },
    "orders": {
      "title": "Orders",
      "description": "Main application orders linked with client Flutter app and driver Flutter app",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "description": "Unique Order ID" },
        "clientId": { "type": "string", "description": "Client UID from 'clients' collection" },
        "driverId": { "type": "string", "description": "Driver UID from 'drivers' collection (null initially)" },
        "items": { "type": "array", "description": "List of ordered products" },
        "totalPrice": { "type": "number", "description": "Total order amount in YER" },
        "location": { "type": "string", "description": "Delivery location" },
        "status": { 
          "type": "string", 
          "enum": ["NEW", "PREPARING", "DELIVERING", "COMPLETED", "CANCELLED"],
          "description": "Lifecycle status of the order" 
        },
        "createdAt": { "type": "string" }
      },
      "required": ["clientId", "items", "totalPrice", "status"]
    }
  },
  "firestore": {
    "adminUsers/{userId}": {
      "schema": "adminUsers",
      "description": "Admins & Dashboard Management staff collection"
    },
    "clients/{userId}": {
      "schema": "clients",
      "description": "Client Mobile App users collection"
    },
    "drivers/{userId}": {
      "schema": "drivers",
      "description": "Driver Mobile App captains collection"
    },
    "stores/{storeId}": {
      "schema": "stores",
      "description": "Stores collection"
    },
    "products/{productId}": {
      "schema": "products",
      "description": "Products collection"
    },
    "orders/{orderId}": {
      "schema": "orders",
      "description": "Orders collection"
    }
  }
}
