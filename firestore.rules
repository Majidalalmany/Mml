rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Security Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user has an active admin role in adminUsers collection
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
          ? (
              get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.status != 'suspended' &&
              get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role in [
                'admin', 'super_admin', 'developer', 'vice_admin', 'stores_manager', 
                'finance_manager', 'accountant', 'customer_service', 'cs_restaurants', 
                'auditor', 'cashier', 'customer_data', 'content_writer', 'content_office', 'custom'
              ]
            )
          : true
      );
    }

    // 1. Admin Users Collection - Staff & Admin management
    match /adminUsers/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. Clients Collection - App end-users
    match /clients/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Drivers Collection - Delivery captains
    match /drivers/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. Catalogue (Stores, Products, Categories) - Public reads, RBAC writes
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fazaa_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /manfaa_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Orders & Services Collections - Public reads, RBAC writes
    match /orders/{orderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fazaa_orders/{orderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /manfaa_orders/{orderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Operational Collections (Audit Logs, Tickets & Invoices)
    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /support_tickets/{ticketId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /driver_invoices/{invoiceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Strict default deny for any undefined or arbitrary paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


